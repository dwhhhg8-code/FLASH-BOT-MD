# انسخ الملف ده إلى .env وحدّد قيمك.
# ملف .env غير مُتتبَّع في git — لا تضع مفاتيح حقيقية هنا.
# شغّل البوت بـ: node --env-file=.env src/index.js

# APIOWO
APIOWO_BASE=https://apiowo.vercel.app
APIOWO_TOKEN=

# NYX DL API
NYX_API_KEY=

# ImgBB
IMGBB_API_KEY=

# ACRCloud (التعرّف على الموسيقى)
ACRCLOUD_HOST=identify-eu-west-1.acrcloud.com
ACRCLOUD_KEY=
ACRCLOUD_SECRET=

# Pexels (صور الأنمي)
PEXELS_API_KEY=

# Pixabay (خلفيات)
PIXABAY_API_KEY=

# Tenor (مزيج الرموز التعبيرية)
TENOR_API_KEY=

# Rule34 (أوامر NSFW)
RULE34_USER_ID=
RULE34_API_KEY=

# Yosoyyo (ستيكر brat)
YOSOYO_API_KEY=

# Yosoyyo (تحميل فيسبوك)
YOSOYO_FB_KEY=
